# URL de base de l'API VigiMoto. Elle doit être JOIGNABLE DEPUIS LE TÉLÉPHONE, pas seulement depuis cet ordinateur :
# utilisez l'adresse IP de votre machine sur le réseau local (téléphone et ordinateur sur le même Wi-Fi), jamais "localhost".
#
#   Serveur Laravel de développement (lancé avec : php artisan serve --host=0.0.0.0) :
#     EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api/v1
#   XAMPP / Apache :
#     EXPO_PUBLIC_API_URL=http://192.168.1.20/Numerise_vignette/public/api/v1
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000/api/v1

# Mode maquette (développement seulement, ignoré dans un build de production) : l'application répond avec des données
# factices conformes au contrat d'API, sans serveur. Utile pour construire un écran avant que son endpoint existe.
EXPO_PUBLIC_USE_MOCK=false
